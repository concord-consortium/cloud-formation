# Copy to researcher-dashboard-runner-staging.yml. create-stack.js requires every
# template parameter to be present here or in the config's ParameterModifications,
# including ones that have defaults in the template.
- ParameterKey: Environment
  ParameterValue: staging
- ParameterKey: Contact
  ParameterValue: dmartin
- ParameterKey: CodeArtifactBucket
  ParameterValue: concord-devops
- ParameterKey: CodeArtifactKey
  ParameterValue: researcher-dashboard-runner/runner-0.1.0.zip
- ParameterKey: BaseImageArn
  ParameterValue: arn:aws:lambda:us-east-1:aws:microvm-image:al2023-1
- ParameterKey: BaseImageVersion
  ParameterValue: '1'
- ParameterKey: BaselineMemoryInMiB
  ParameterValue: '4096'
- ParameterKey: HooksPort
  ParameterValue: '8080'
- ParameterKey: LogRetentionInDays
  ParameterValue: '30'
